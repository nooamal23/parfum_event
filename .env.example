# ============================
# Base de données PostgreSQL
# ============================
POSTGRES_USER=parfum_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=parfum_event
POSTGRES_PORT=5432
# Utilisé par le backend pour se connecter (le host "db" est le nom du service docker-compose)
DATABASE_URL=postgresql://parfum_user:change_me_in_production@db:5432/parfum_event

# ============================
# Backend (API)
# ============================
NODE_ENV=development
PORT=4000
# Origine autorisée pour le CORS (URL publique du frontend)
FRONTEND_URL=http://localhost:3000

# Secret de signature des JWT admin — générer avec: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_real_secret
JWT_EXPIRES_IN=8h

# Durée de vie du lien de validation d'e-mail (en minutes)
EMAIL_TOKEN_TTL_MINUTES=60

# Compte admin créé automatiquement si la table admins est vide (bootstrap initial)
ADMIN_BOOTSTRAP_EMAIL=admin@parfumacademy.tn
ADMIN_BOOTSTRAP_PASSWORD=change_me_in_production

# ============================
# Informations pratiques de l'événement
# (utilisées dans l'e-mail "envoyer-info" envoyé par l'admin depuis le back-office)
# ============================
EVENT_DATE=Samedi 12 septembre 2026
EVENT_TIME=9h00 - 12h00
EVENT_LOCATION=Salle Jasmin, Hôtel Golden Tulip, Sousse
EVENT_PRICE=120 DT
EVENT_NOTES=Places limitées, merci d'arriver 15 minutes avant le début.

# ============================
# Envoi d'e-mails (SMTP)
# ============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASSWORD=change_me
EMAIL_FROM="Univers des Parfums <no-reply@parfumacademy.tn>"

# ============================
# Frontend (Next.js)
# ============================
# URL publique de l'API, exposée au navigateur (doit commencer par NEXT_PUBLIC_).
# En production : l'URL HTTPS réelle de l'API, ex. https://api.mondomaine.tn
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL interne utilisée uniquement par Next.js côté serveur (SSR, Server Components),
# à l'intérieur du réseau Docker. NE PAS mettre d'URL publique ici : "backend" est
# le nom du service docker-compose, résolu uniquement entre conteneurs.
API_URL_INTERNAL=http://backend:4000
